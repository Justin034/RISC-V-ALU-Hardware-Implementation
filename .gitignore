*.qws

# Quartus databases
*.qdb

# Quartus reports
*.rpt
*.summary
*.smsg

# Quartus generated programming files
*.sof
*.pof
*.jic
*.jdi

# Quartus generated assignment/report files
*.pin
*.cmp

# Other Quartus generated files
*.done


# ============================================================
# ModelSim / Questa
# ============================================================

# Compiled VHDL simulation library
simulation/work/

# If ModelSim creates work elsewhere
work/

# Simulator transcript
transcript

# Waveform files
*.wlf
*.vcd
*.fst

# ModelSim/Questa generated configuration
modelsim.ini

# Compiled simulator libraries
*_lib/

# Simulator temporary files
*.dat
*.idx


# ============================================================
# General Simulation Output
# ============================================================

simulation/transcript
simulation/*.wlf
simulation/*.vcd
simulation/*.fst

# Temporary simulation files
*.log
*.tmp
*.temp


